# Copy this file to .env and fill in your own values.
# Do NOT commit your actual .env file to source control.

# --- Mailgun (used by Send Message > Email) ---
MailgunApiKey=your-mailgun-private-api-key
MailgunDomain=your-mailgun-sandbox-or-verified-domain
EmailFrom=Excited User <mailgun@your-domain.mailgun.org>

# --- Twilio (used by Send Message > SMS) ---
TwilioSid=your-twilio-account-sid
TwilioToken=your-twilio-auth-token
SmsFrom=+10000000000
